    "pubDebatesDebateIdEarlyEndAccept" : {
      "address" : "/pub/debates/{debateId}/early-end/accept",
      "description" : "자유 토론 조기 종료 제안 수락. 성공하면 같은 토론방을 구독 중인 모든 참가자에게 EARLY_END_ACCEPTED 이벤트가, 이어서 최종 판결 단계로의 STAGE_CHANGED 이벤트가 전달된다",
      "servers" : [ {
        "$ref" : "#/servers/stomp"
      } ],
      "parameters" : {
